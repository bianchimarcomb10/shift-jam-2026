/// La TRIVELLA LANCIATA: parte quando, con la carica piena (10 colpi parati andati a segno),
/// il mecha torna navicella. Sale, accelera e si ingrandisce sempre di piu'.
/// Se colpisce un nemico gli fa il danno di 20 colpi ed esplode. Il mecha tiene comunque la sua trivella.
sc = 1;      // grandezza: cresce durante il volo
v = 2;       // velocita' verso l'alto
ph = 0;      // rotazione della spirale
depth = -4;
